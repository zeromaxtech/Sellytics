# Sellytics environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=
# Public/anon key (some setups name it SUPABASE_ANON_KEY).
SUPABASE_PUBLISHABLE_KEY=
# Service-role key (some setups name it SUPABASE_SERVICE_ROLE_KEY).
# Used ONLY server-side: daily tips upsert, digest runs,
# account deletion, /run-digest. Never exposed to the browser.
SUPABASE_SECRET_KEY=

# --- App ---
# Secret shared with external schedulers that call POST /run-digest
# via the X-Cron-Secret header. Use a long random string.
CRON_SECRET=
# Key used to encrypt Printify API tokens at rest (AES-256-GCM).
ENCRYPTION_KEY=

# --- Email (Gmail SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Daily AI tips (optional — dashboard falls back to evergreen tips) ---
OPENROUTER_API_KEY=
# Free models cost nothing; paid models need OpenRouter credits.
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Printify webhooks / live orders ---
# The secret you set when creating the Printify webhook. Printify signs
# each request with X-Pfy-Signature: sha256=<hmac_sha256(raw_body, secret)>.
# Generate a long random value and use the same value in Printify.
PRINTIFY_WEBHOOK_SECRET=
# Public base URL of the deployed site, used when registering webhooks.
# Example: https://sellytics.netlify.app (no trailing slash).
APP_BASE_URL=
# Optional: flag an in-production order as a shipping problem after this
# many days without a shipment. Default is 10.
DELAYED_SHIPPING_DAYS=10

# --- Web push (order issue alerts) ---
# Generate a key pair with: npx web-push generate-vapid-keys
# The public key is sent to the browser via /public-config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the push spec. Use a real mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# --- Optional ---
# Process timezone for date formatting. The scheduled function
# itself always runs on UTC (see the schedule in netlify.toml).
# TZ=Europe/Berlin
